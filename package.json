{
  "name": "dbms-learning-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:init": "node scripts/run-init-db.mjs",
